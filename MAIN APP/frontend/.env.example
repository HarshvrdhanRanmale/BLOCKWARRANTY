# ==========================================
# BlockWarranty Frontend Environment Example
# ==========================================

# MetaMask Embedded Wallets Configuration
# Get your Client ID from https://developer.metamask.io or https://dashboard.web3auth.io
VITE_METAMASK_EMBEDDED_CLIENT_ID=

# Network: sapphire_devnet (testing) or sapphire_mainnet (production)
VITE_METAMASK_NETWORK=sapphire_devnet

# Local demo chain (no real ETH, faucet, or deployment key required)
VITE_BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
VITE_BLOCKCHAIN_CHAIN_ID=31337
VITE_WEB3AUTH_RPC_URL=http://localhost:5173/api/blockchain/rpc

# BlockWarranty Authentication Backend
VITE_API_BASE_URL=

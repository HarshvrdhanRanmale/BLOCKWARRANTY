# ==========================================
# BlockWarranty Environment Configuration
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=blockwarranty_dev_jwt_secret_key_987654321
JWT_EXPIRES_IN=24h

# Local demo chain (chain ID 31337)
RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=31337
CONTRACT_ADDRESS=

# Frontend Origin for CORS
FRONTEND_URL=http://localhost:5173

# Google Identity Services Web client ID (same value in backend and frontend).
# The backend validates ID tokens; this client ID is not a secret.
GOOGLE_CLIENT_ID=

# Razorpay Test Mode (UPI) — Transfer Ownership payments (backend only).
# Create Test keys at https://dashboard.razorpay.com (switch to Test Mode).
# KEY_SECRET must stay server-side and is never exposed to the frontend.
# If left blank, payment is disabled and the backend returns a clear error.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Relayer wallet (backend only) — enables AUTOMATIC ownership transfer after a
# verified payment. A dedicated low-value Sepolia wallet authorized on-chain.
# Never a user wallet. Automatic ownership transfers require the relayer-enabled
# migration contract and its configured address.
RELAYER_PRIVATE_KEY=

# Dedicated Sepolia contract deployer with test ETH. Keep both keys server-side.
SEPOLIA_DEPLOYER_PRIVATE_KEY=

# CheckWarranty B2B Public API (Third-party Warranty Aggregator)
# Secret key stays server-side only. If left blank, BlockWarranty safely falls back
# to the existing Supplier Database and Inventory verification workflow.
CHECKWARRANTY_API_KEY=
CHECKWARRANTY_BASE_URL=https://checkwarranty.info

# MetaMask Embedded Wallets Public Client Configuration (for Frontend)
# Obtain from https://developer.metamask.io
VITE_METAMASK_EMBEDDED_CLIENT_ID=
VITE_API_BASE_URL=http://localhost:5000
VITE_GOOGLE_CLIENT_ID=
